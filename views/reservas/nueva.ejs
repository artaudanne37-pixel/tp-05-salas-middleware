
<section>
  <h2>Nueva reserva</h2>

  <% if (error) { %>
    <p role="alert"><%= error %></p>
  <% } %>

  <form action="/reservas" method="POST">
    <div>
      <label for="estudiante">Estudiante:</label>
      <input
        type="text"
        id="estudiante"
        name="estudiante"
        value="<%= valores.estudiante || '' %>"
      >
    </div>

    <div>
      <label for="email">Email:</label>
      <input
        type="text"
        id="email"
        name="email"
        value="<%= valores.email || '' %>"
      >
    </div>

    <div>
      <label for="sala">Sala:</label>
      <select id="sala" name="sala">
        <option value="">Seleccionar sala</option>
        <option
          value="Sala Norte"
          <%= valores.sala === "Sala Norte" ? "selected" : "" %>
        >
          Sala Norte
        </option>
        <option
          value="Sala Sur"
          <%= valores.sala === "Sala Sur" ? "selected" : "" %>
        >
          Sala Sur
        </option>
        <option
          value="Sala Multimedia"
          <%= valores.sala === "Sala Multimedia" ? "selected" : "" %>
        >
          Sala Multimedia
        </option>
      </select>
    </div>

    <div>
      <label for="fecha">Fecha:</label>
      <input
        type="date"
        id="fecha"
        name="fecha"
        value="<%= valores.fecha || '' %>"
      >
    </div>

    <div>
      <label for="turno">Turno:</label>
      <select id="turno" name="turno">
        <option value="">Seleccionar turno</option>
        <option
          value="Mañana"
          <%= valores.turno === "Mañana" ? "selected" : "" %>
        >
          Mañana
        </option>
        <option
          value="Tarde"
          <%= valores.turno === "Tarde" ? "selected" : "" %>
        >
          Tarde
        </option>
        <option
          value="Noche"
          <%= valores.turno === "Noche" ? "selected" : "" %>
        >
          Noche
        </option>
      </select>
    </div>

    <div>
      <label for="personas">Personas:</label>
      <input
        type="number"
        id="personas"
        name="personas"
        min="1"
        max="6"
        value="<%= valores.personas || '' %>"
      >
    </div>

    <button type="submit">Guardar reserva</button>
  </form>

  <p>
    <a href="/reservas">Volver a las reservas</a>
  </p>
</section>

